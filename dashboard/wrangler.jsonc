{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meshrmm-dashboard",
  "account_id": "023f5fc9ffca88a15dac8e9f27b8d21f",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "meshrmm.com",
      "custom_domain": true
    },
    {
      "pattern": "www.meshrmm.com",
      "custom_domain": true
    },
    {
      "pattern": "admin.meshrmm.com",
      "custom_domain": true
    },
    {
      "pattern": "auth.meshrmm.com",
      "custom_domain": true
    },
    {
      "pattern": "*.meshrmm.com/*",
      "zone_name": "meshrmm.com"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pulsermm-production",
      "database_id": "4650d279-149e-4a0b-8ec9-3058711885ea"
    }
  ],
  // Per-company usage for the platform cost report; see docs/cost-tracking.md.
  "analytics_engine_datasets": [
    {
      "binding": "USAGE",
      "dataset": "meshrmm_usage"
    }
  ],
  "services": [
    {
      "binding": "MESHRMM_API",
      "service": "pulsermm-server"
    }
  ],
  "vars": {
    "WORKOS_CLIENT_ID": "client_01M0FT1AN01PAT37N98EMRSNVW",
    // The MeshRMM organization; admin.meshrmm.com signs owners in to it.
    "PLATFORM_WORKOS_ORGANIZATION_ID": "org_01M0FXR8A4Q1W8WAHXME7HPKQW",
    "MESHRMM_SERVER_URL": ""
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
